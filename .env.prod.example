# Production environment variables for Campus Football.
#
# Copy this file to .env.prod and fill in every value before deploying.
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored and must never be committed.
# See docs/PRODUCTION_DEPLOY.md for generation instructions and a
# pre-flight checklist.

# ─── Django ──────────────────────────────────────────────────────────────────
# Generate each key with: python -c "import secrets; print(secrets.token_hex(50))"
# The two keys must be different values.
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=

# Comma-separated list of hostnames Django will serve (no scheme, no port).
# Must include your public domain, e.g.: app.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Comma-separated scheme+host CORS origins the API will accept.
# Typically the same as your public HTTPS domain: https://app.example.com
CORS_ALLOWED_ORIGINS=

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=campus_football
POSTGRES_USER=campus_football_user
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# POSTGRES_HOST is set to "db" by docker-compose.prod.yml and must not be
# overridden here — the override in the Compose environment: block takes
# precedence, so any value you put here is silently ignored.

# ─── Gunicorn — real client IP forwarding ────────────────────────────────────
# Which IPs are allowed to set X-Forwarded-For so gunicorn updates REMOTE_ADDR.
# This is set to 172.16.0.0/12 (all Docker bridge networks) in docker-compose
# directly, so you do not need to set it here unless you override it.
# See docs/PRODUCTION_DEPLOY.md § Real client IP forwarding.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# ─── Nginx — real client IP forwarding ───────────────────────────────────────
# The IP or CIDR of the trusted upstream as seen by the frontend nginx
# container.  In the standard Docker Compose topology, external connections
# arrive through Docker's published port and Docker NAT rewrites the source
# address to the bridge gateway IP.  Discover the correct value on a running
# stack with:
#
#   docker network inspect <compose-project>_default \
#     --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
#
# Example (same-host deployment):  NGINX_TRUSTED_PROXY=172.21.0.1
# Example (separate proxy host):   NGINX_TRUSTED_PROXY=203.0.113.10
#
# If left empty, the realip module is inactive and LoginRateThrottle will
# rate-limit all users as a single bucket (degraded but safe).
# Do NOT use 0.0.0.0/0 — docker-entrypoint.sh will refuse to start nginx.
#
# See docs/PRODUCTION_DEPLOY.md § Real client IP forwarding.
NGINX_TRUSTED_PROXY=
